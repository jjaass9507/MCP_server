# MCP Server Configuration
# Copy this file to config.toml and edit the values.
# You can also point to a custom path with: MCP_CONFIG=/path/to/config.toml
#
# Logging is configured via environment variables (not this file):
#   MCP_LOG_LEVEL   DEBUG | INFO | WARNING | ERROR   (default: INFO)
#   MCP_LOG_FILE    optional path; logs also written here in addition to stderr
#
# Configuration is validated at startup: a non-existent allowed_path or a
# database whose parent directory is missing will stop the server with an error.

[tools]
# Registration profiles reduce the tool schemas sent to the model.
# all          = every category (backwards-compatible default)
# core         = filesystem + database + custom + api
# gms          = custom + gms
# presentation = custom + presentation
# minimal      = custom utilities only
profile = "all"

# Optional exact override for profile. Valid categories are:
# filesystem, database, custom, api, presentation, gms
# enabled_categories = ["database", "custom", "gms"]

[http]
# Streamable HTTP endpoint: http://host:port/mcp
# Localhost is the secure default. A non-local bind requires the bearer-token
# environment variable below to be set at runtime.
host = "127.0.0.1"
port = 8080

# DNS-rebinding protection. Add the exact gateway hostname/IP used by clients
# before binding beyond localhost, e.g. "mcp.internal.example:8080".
allowed_hosts = ["127.0.0.1:*", "localhost:*", "[::1]:*"]

# Origin may be absent for non-browser MCP clients. Browser clients that send
# Origin must match this list; add the exact trusted UI origin when needed.
allowed_origins = [
    "http://127.0.0.1:*",
    "http://localhost:*",
    "http://[::1]:*",
]

# The token itself is never stored in TOML. This names the environment variable
# that supplies it. It is optional for localhost and mandatory for non-local
# Streamable HTTP binds. Generate a strong value, e.g. `python -c "import
# secrets; print(secrets.token_urlsafe(32))"`.
bearer_token_env = "MCP_HTTP_BEARER_TOKEN"

[filesystem]
# Directories the server is allowed to read.
# All paths must be absolute. Sub-paths are automatically allowed.
# Empty list = all access denied.
allowed_paths = [
    "/home/user/data",
    "/tmp/workspace",
]

# Set to false for read-only mode (write_file and delete_file will be rejected).
allow_write = true

[database]
# Named aliases for SQLite, PostgreSQL, SQL Server or Oracle databases.
# Tools accept db_name (the key) instead of a raw path or DSN.
# SQLite     → absolute file path
# PostgreSQL → postgresql://user:password@host:port/dbname
# SQL Server → mssql://user:password@host:port/dbname
# Oracle     → oracle://user:password@host:port/service_name  (read-only)
[database.connections]
mydb      = "/home/user/data/mydb.sqlite"
analytics = "/home/user/data/analytics.sqlite"

# PostgreSQL examples:
# pgdb     = "postgresql://myuser:mypassword@localhost:5432/mydb"
# prod     = "postgresql://appuser:secret@db.internal:5432/production"

# SQL Server (MSSQL) example:
# NOTE: Use a Python DSN, NOT a JDBC URL. The JDBC form
# 'jdbc:sqlserver://db:1433;databaseName=fac_power;user=aa;password=aa;...'
# becomes:
# MSSQL    = "mssql://aa:aa@db:1433/fac_power"

# Oracle example (READ-ONLY: db_query / db_list_* / db_table_schema only).
# Uses the service name (not SID) after the slash. Query binds use :1 / :name.
# ora      = "oracle://scott:tiger@db:1521/XEPDB1"

# Max concurrent connections kept open per PostgreSQL/SQL Server/Oracle DSN.
# Requests beyond this wait for one to free up instead of opening a new
# connection, so concurrent tool calls can't exceed the target database's
# max_connections limit. SQLite is unaffected (always a direct file connection).
# pool_size = 5

# Database access is read-only by default. Opt in separately for each alias
# that must accept writes. db_execute is limited to one INSERT/UPDATE/DELETE.
# Multi-statement scripts require the additional allow_scripts opt-in.
# [database.access.mydb]
# read_only = false
# allow_scripts = false

[export]
# Directory used by db_query_to_file and gms_history_values(to_file=true) to
# write large results (CSV) instead of returning them inline to the model.
# Only required if you use those tools.
# Must already exist — startup validation fails if it doesn't.
# Automatically added to filesystem allowed_paths, so read_file/list_directory
# can also reach it (e.g. to preview a file's size), but do NOT read a whole
# large CSV back into the model's context — that defeats the purpose.
# Files older than 7 days (*.csv) are deleted automatically on each write.
dir = "D:/FAC_Job/mcp_exports"

# Optional: serve exported CSVs over HTTP so a *different* machine's MCP
# server (e.g. one running the Python code that actually processes this
# data) can download them by URL, since it has no access to this machine's
# filesystem. The query tools then add a "download_url" alongside "path" in
# their response — the CSV contents themselves never pass back through this
# server's own tool responses.
#
# serve_downloads = false
#
# Bind address for the download HTTP server on *this* machine. "0.0.0.0"
# listens on all interfaces; narrow it if this machine has multiple NICs.
# download_host = "0.0.0.0"
#
# The IP/hostname the OTHER machine should use to reach this one. Required
# whenever serve_downloads is true — this server cannot auto-detect its own
# externally reachable address, and startup validation will refuse to start
# without it.
# advertise_host = "10.0.1.23"
#
# Port for the download HTTP server. Make sure the firewall on this machine
# allows inbound connections to it from the consuming machine.
# download_port = 8081
#
# Minutes before a download_url expires; after that, re-run the query tool
# to get a fresh URL (the file itself is untouched, only re-registered).
# The id in each URL is unguessable (secrets.token_urlsafe), but anyone who
# obtains a valid URL before it expires can download that one file — an
# acceptable risk level on an isolated internal network, not over the open
# internet.
# url_ttl_minutes = 60

[api]
# External HTTP APIs the server may call, addressed by a service name (the key).
# The model uses the service name (e.g. "weather"); the api_key never leaves
# the server. base_url is required; the auth fields are only needed if the
# API expects a key in a header.
#
# API Key / Bearer token style (Authorization: Bearer <key>):
# [api.services.weather]
# base_url    = "https://api.openweathermap.org/data/2.5"
# api_key     = "your-key-here"
# auth_header = "Authorization"   # header name the key goes into
# auth_prefix = "Bearer "         # prefix before the key
# allowed_methods = ["GET"]
# allowed_path_prefixes = ["/weather", "/forecast"]
# timeout_seconds = 30             # maximum allowed: 120
# max_request_body_bytes = 100000  # maximum allowed: 1000000
#
# X-API-Key style (X-API-Key: <key>):
# [api.services.someservice]
# base_url    = "https://api.example.com"
# api_key     = "abc123"
# auth_header = "X-API-Key"
# auth_prefix = ""
#
# Optional extra static headers per service:
# [api.services.weather.headers]
# Accept = "application/json"
#
# Public API with no key (just omit the api_key/auth_* fields):
# [api.services.httpbin]
# base_url = "https://httpbin.org"
# allowed_methods = ["GET", "POST"]
# allowed_path_prefixes = ["/anything"]
#
# Push+ 2.0 notification API (token goes in the POST body — used by push_notify):
# verify = false skips TLS certificate verification, for internal services whose
# certificate is not publicly trusted.
# [api.services.pushplus]
# base_url = "https://pushplus.kh.asegroup.com/v1/web_api/"
# token    = "your-token-here"
# verify   = false

[presentation]
# Default style applied to every presentation when not explicitly overridden.
# The agent does NOT need to specify these — they are applied automatically.
#
# Presets: corporate | modern | dark | minimal | tech | aurora | bright_sans | warm
default_preset      = "aurora"
#
# Fonts: Arial | Calibri | Noto Sans | Microsoft JhengHei | Microsoft YaHei | ...
# default_title_font  = "Microsoft JhengHei"
# default_body_font   = "Microsoft JhengHei"
#
# Show page number + section name in footer
# default_show_footer = true
